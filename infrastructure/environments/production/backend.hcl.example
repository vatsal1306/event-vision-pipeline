# Copy to backend.hcl and replace BUCKET_NAME with the value from:
#   cd infrastructure/bootstrap && terraform output -raw state_bucket_name
#
# Usage (from infrastructure/):
#   terraform init -backend-config=environments/production/backend.hcl

bucket         = "BUCKET_NAME"
key            = "production/terraform.tfstate"
region         = "ap-south-1"
dynamodb_table = "terraform-locks"
encrypt        = true
