# GPU host — copy to ~/event-vision-pipeline/backend/.env on the GPU EC2.
# chmod 600 .env
# Do not put GPU_INSTANCE_ID or AWS_COMPUTE_* here. Those live on the app EC2.

# App EC2 private IPv4 (not the Elastic IP, not Docker names db/redis)
APP_PRIVATE_IP=172.31.x.x

DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@172.31.x.x:5432/photoshare
REDIS_URL=redis://172.31.x.x:6379/0
CELERY_BROKER_URL=redis://172.31.x.x:6379/1
CELERY_RESULT_BACKEND=redis://172.31.x.x:6379/2

# Same storage-account S3 keys as the app (terraform output app_env_file_snippet)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_ORIGINALS=platform-originals-YOUR_ACCOUNT_ID
S3_BUCKET_PROXIES=platform-proxies-YOUR_ACCOUNT_ID
S3_BUCKET_ASSETS=platform-assets-YOUR_ACCOUNT_ID

ML_FACE_PROCESSING_ENABLED=true
ML_DEVICE=cuda
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=unused-on-gpu-worker
