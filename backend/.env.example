# Backend environment variables
# Copy to backend/.env (gitignored). The app always loads this file, not the repo-root .env.

# Application
APP_NAME="SpotMe"
DEBUG=true
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=dev-only-change-me

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/photoshare
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS S3 (leave empty for local; real keys come later / on the server)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_ORIGINALS=platform-originals
S3_BUCKET_PROXIES=platform-proxies
S3_BUCKET_ASSETS=platform-assets
S3_PRESIGNED_URL_EXPIRY=3600

# JWT (couple sessions reuse JWT_GUEST_TOKEN_EXPIRE_DAYS)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_GUEST_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60

# SMS / email — Phase 1: log OTP, skip real email
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=PHOTOS
EMAIL_PROVIDER=none
EMAIL_FROM=noreply@platform.com
SES_REGION=ap-south-1

# Processing
PROXY_MAX_DIMENSION=2048
PROXY_QUALITY=82
WATERMARK_OPACITY=0.4
MAX_UPLOAD_SIZE_BYTES=52428800

# Sentry (leave empty locally; set on the server when error tracking is wanted)
SENTRY_DSN=
