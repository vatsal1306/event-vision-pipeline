# Backend environment variables
# Copy to .env and fill in real values

# Application
APP_NAME="AI Photo Sharing Platform"
DEBUG=true
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-me-to-a-real-secret-key

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/photoshare

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS S3 (leave empty for local dev; use MinIO or localstack)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_ORIGINALS=platform-originals
S3_BUCKET_PROXIES=platform-proxies
S3_BUCKET_ASSETS=platform-assets

# JWT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# SMS (leave empty for dev — OTP will be logged)
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=PHOTOS

# Email
EMAIL_PROVIDER=ses
EMAIL_FROM=noreply@platform.com

# ML (override for local dev)
ML_DEVICE=cpu
ML_SCRFD_MODEL_PATH=models/det_10g.onnx
ML_EMBEDDING_MODEL=r100
ML_EMBEDDING_MODEL_PATH=models/model_v1_scratch_training_epoch_20_r100.pt
ML_BLUR_MODEL_PATH=models/blur_model_tflite_may6_ckpt49.tflite
ML_YPR_MODEL_PATH=models/ypr_model_float32.tflite

# Sentry (leave empty for dev)
SENTRY_DSN=
