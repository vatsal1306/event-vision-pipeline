# Backend environment variables
# Copy to backend/.env (gitignored). The app always loads this file, not the repo-root .env.

# Application
APP_NAME="SpotMe"
DEBUG=true
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=dev-only-change-me

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/photoshare
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS S3 — local tusd uses these keys to write originals (same path as production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_ORIGINALS=platform-originals
S3_BUCKET_PROXIES=platform-proxies
S3_BUCKET_ASSETS=platform-assets
S3_PRESIGNED_URL_EXPIRY=3600

# JWT (couple sessions reuse JWT_GUEST_TOKEN_EXPIRE_DAYS)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_GUEST_TOKEN_EXPIRE_DAYS=30

# OTP
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=60

# SMS / email
# log = print OTP path in logs + DEBUG 123456 still works
# fast2sms = real SMS to Indian mobiles (set SMS_API_KEY from Fast2SMS dashboard)
SMS_PROVIDER=log
SMS_API_KEY=
SMS_SENDER_ID=PHOTOS

# smtp = Google Workspace / Gmail (App Password). log/none = write to logs only.
# Google: enable 2-Step Verification, then create an App Password (not your Gmail password).
EMAIL_PROVIDER=smtp
EMAIL_FROM=admin@hpklabs.ai
EMAIL_FROM_NAME=SpotMe
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@hpklabs.ai
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_NAME=SpotMe
SMTP_USE_TLS=true
SES_REGION=ap-south-1

# Processing
PROXY_MAX_DIMENSION=2048
PROXY_QUALITY=82
WATERMARK_OPACITY=0.4
MAX_UPLOAD_SIZE_BYTES=52428800

# Sentry (leave empty locally; set on the server when error tracking is wanted)
SENTRY_DSN=

# Leave empty on the laptop (run a local face worker).
# On the app EC2: instance id + compute-account keys (not S3 keys).
GPU_INSTANCE_ID=
AWS_COMPUTE_ACCESS_KEY_ID=
AWS_COMPUTE_SECRET_ACCESS_KEY=
AWS_COMPUTE_REGION=ap-south-1
GPU_IDLE_STOP_MINUTES=10

# Face matching (Find faces). true on the laptop so photographers can run E2E.
# Also start: uv run celery -A app.tasks.celery_app worker -Q face_processing -c 1
ML_FACE_PROCESSING_ENABLED=true
ML_DEVICE=cpu
