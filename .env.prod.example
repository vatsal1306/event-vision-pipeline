# Production environment for ~/event-vision-pipeline on the app EC2.
# Copy: cp .env.prod.example .env  then fill in values. chmod 600 .env
#
# S3 keys are SHARED (not separate dev/prod) — one storage account, one IAM user.

# --- S3 (storage account) — from: cd infrastructure && terraform output -raw app_env_file_snippet ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_ORIGINALS=platform-originals-YOUR_ACCOUNT_ID
S3_BUCKET_PROXIES=platform-proxies-YOUR_ACCOUNT_ID
S3_BUCKET_ASSETS=platform-assets-YOUR_ACCOUNT_ID

# --- Generate on EC2 (do not reuse dev laptop secrets in prod if avoidable) ---
# openssl rand -hex 32
SECRET_KEY=

# openssl rand -base64 24  (no slashes — or use hex)
POSTGRES_PASSWORD=

# --- Constructed from POSTGRES_PASSWORD (db = Docker service name) ---
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/photoshare

# --- Fixed Docker Compose service hostnames ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- App URLs (your real domain) ---
FRONTEND_URL=https://spotme.hpklabs.ai
API_BASE_URL=https://spotme.hpklabs.ai/api
ENVIRONMENT=production
DEBUG=false

# Laptop: omit GPU_* and AWS_COMPUTE_*. ---
ML_FACE_PROCESSING_ENABLED=true
ML_DEVICE=cpu
GPU_INSTANCE_ID=
AWS_COMPUTE_ACCESS_KEY_ID=
AWS_COMPUTE_SECRET_ACCESS_KEY=
AWS_COMPUTE_REGION=ap-south-1
GPU_IDLE_STOP_MINUTES=10

# --- OTP SMS: log locally, or Fast2SMS for real Indian mobiles ---
# DEBUG=false disables the 123456 shortcut. Then SMS_PROVIDER=fast2sms and SMS_API_KEY are required.
SMS_PROVIDER=log
SMS_API_KEY=

# --- Frontend build-time (used by docker compose build args) ---
NEXT_PUBLIC_APP_URL=https://spotme.hpklabs.ai
NEXT_PUBLIC_API_BASE_URL=https://spotme.hpklabs.ai/api
NEXT_PUBLIC_MOCK_API=false
